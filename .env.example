# NOVA Desktop AI Assistant Environment Configuration Example
# Copy this file to .env and adjust values as needed. Never commit .env to Git.

# Application Environment (development, production, testing)
NOVA_ENV=development

# Backend Server Settings
NOVA_HOST=127.0.0.1
NOVA_PORT=8000

# Logging
LOG_LEVEL=INFO

# Security / CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Windows Startup
AUTO_START=false
